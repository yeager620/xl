<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.yeager620.xl</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>MIT OR Apache-2.0</project_license>
  <name>xl</name>
  <summary>Edit spreadsheets, fast</summary>
  <description>
    <p>
      xl is a native spreadsheet for Linux. It opens and saves Excel workbooks
      and CSV files, and recalculates only what changed, so edits show up
      instantly even in large sheets.
    </p>
    <ul>
      <li>Formulas with Excel syntax, cross-sheet references and 77 functions</li>
      <li>Number formats, cell styles and multiple sheets, round-tripped through .xlsx</li>
      <li>Excel keyboard shortcuts, point-to-reference formula entry and a command palette</li>
      <li>Autosave with crash recovery</li>
    </ul>
  </description>
  <url type="homepage">https://github.com/yeager620/xl</url>
  <url type="bugtracker">https://github.com/yeager620/xl/issues</url>
  <url type="vcs-browser">https://github.com/yeager620/xl</url>
  <developer id="io.github.yeager620">
    <name>xl contributors</name>
  </developer>
  <launchable type="desktop-id">io.github.yeager620.xl.desktop</launchable>
  <provides>
    <binary>xl</binary>
    <mediatype>application/vnd.openxmlformats-officedocument.spreadsheetml.sheet</mediatype>
    <mediatype>text/csv</mediatype>
  </provides>
  <categories>
    <category>Office</category>
    <category>Spreadsheet</category>
  </categories>
  <screenshots>
    <screenshot type="default">
      <caption>A budget with live totals for the selected cells</caption>
      <image>https://raw.githubusercontent.com/yeager620/xl/v0.1.1/packaging/screenshots/screenshot-1.png</image>
    </screenshot>
    <screenshot>
      <caption>Writing a formula, with each reference highlighted in the grid</caption>
      <image>https://raw.githubusercontent.com/yeager620/xl/v0.1.1/packaging/screenshots/screenshot-2.png</image>
    </screenshot>
    <screenshot>
      <caption>Every command a keystroke away in the command palette</caption>
      <image>https://raw.githubusercontent.com/yeager620/xl/v0.1.1/packaging/screenshots/screenshot-3.png</image>
    </screenshot>
  </screenshots>
  <branding>
    <color type="primary" scheme_preference="light">#D6E3F7</color>
